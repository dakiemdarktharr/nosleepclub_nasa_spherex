{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python build_public.py",
  "outputDirectory": "public",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/data_import.py": {
      "maxDuration": 30,
      "includeFiles": "api/_data_manifest.json",
      "excludeFiles": "{data/**,public/**,assets/**,*.html,*.css,*.js,*.svg}"
    },
    "api/data.py": {
      "maxDuration": 30,
      "includeFiles": "api/_data_manifest.json",
      "excludeFiles": "{data/**,public/**,assets/**,*.html,*.css,*.js,*.svg}"
    },
    "api/reviews.py": {
      "maxDuration": 15,
      "includeFiles": "api/_review_manifest.json",
      "excludeFiles": "{data/**,assets/**,*.html,*.css,*.js,*.svg}"
    },
    "api/observations.py": {
      "maxDuration": 30,
      "excludeFiles": "{data/**,assets/**,*.html,*.css,*.js,*.svg}"
    },
    "api/frame.py": {
      "maxDuration": 120,
      "excludeFiles": "{data/**,assets/**,*.html,*.css,*.js,*.svg}"
    }
  },
  "rewrites": [
    {"source": "/data/:asset*", "destination": "/api/data?path=data/:asset*"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
